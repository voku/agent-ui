#!/usr/bin/env php
<?php

declare(strict_types=1);

use voku\AgentUi\Runtime\ControlPlaneIdentity;
use voku\AgentUi\Runtime\ControlPlaneProbe;

$autoload = null;
foreach ([
    $_composer_autoload_path ?? null,
    dirname(__DIR__) . '/vendor/autoload.php',
    dirname(__DIR__, 3) . '/autoload.php',
] as $candidate) {
    if (is_string($candidate) && is_file($candidate)) {
        $autoload = $candidate;
        break;
    }
}

if ($autoload === null) {
    fwrite(STDERR, "Dependencies are not installed. Run composer install.\n");
    exit(1);
}

require $autoload;

$help = static function (): void {
    echo <<<HELP
agent-ui - Local server-rendered human control plane for voku/agent-loop

Usage:
  agent-ui [serve] [--port=PORT] [--host=HOST] [--root=PATH]
  agent-ui status [--port=PORT] [--host=HOST] [--root=PATH] [--format=text|json]
  agent-ui session serve TASK [--root=PATH] [--port=PORT]
  agent-ui session start TASK [--host=shell|agy|codex|claude] [--root=PATH] [--port=PORT]
  agent-ui session attach TASK [--root=PATH] [--port=PORT]
  agent-ui session status TASK [--root=PATH] [--format=text|json]
  agent-ui session stop TASK [--root=PATH]
  agent-ui help

Commands:
  serve          Run the local foreground HTTP server (default command).
  status         Probe whether this endpoint is agent-ui for the exact project.
  session        Manage the optional local coding-host terminal cockpit.
  help           Show this help message.

Options:
  --port=PORT    Port to serve/probe (default: 8088)
  --host=HOST    Host address to serve/probe (default: 127.0.0.1)
  --root=PATH    Target project root path (default: current working directory)
  --format=FORMAT  Status output: text or json (default: text)
  -h, --help     Show this help message

HELP;
};

$args = array_slice($argv, 1);
$command = 'serve';
if ($args !== [] && !str_starts_with($args[0], '-')) {
    $command = array_shift($args);
}

if ($command === 'help') {
    $help();
    exit(0);
}
if ($command === 'session') {
    $sessionAction = array_shift($args);
    if ($sessionAction === '--help' || $sessionAction === '-h') {
        $help();
        exit(0);
    }
    $taskId = array_shift($args);
    if (!is_string($sessionAction) || !in_array($sessionAction, ['serve', 'start', 'attach', 'status', 'stop'], true)
        || !is_string($taskId) || preg_match('/^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/D', $taskId) !== 1) {
        fwrite(STDERR, "Error: session requires an action and a valid task ID.\n");
        $help();
        exit(1);
    }

    $sessionOptions = [];
    foreach ($args as $arg) {
        if (preg_match('/^--(root|port|host|format)=(.+)$/D', $arg, $matches) !== 1 || isset($sessionOptions[$matches[1]])) {
            fwrite(STDERR, "Error: invalid or repeated session option.\n");
            exit(1);
        }
        $sessionOptions[$matches[1]] = $matches[2];
    }
    $sessionRoot = $sessionOptions['root'] ?? getcwd();
    $sessionHost = $sessionOptions['host'] ?? null;
    $sessionPort = $sessionOptions['port'] ?? null;
    $sessionFormat = $sessionOptions['format'] ?? null;
    if (!is_string($sessionRoot) || !is_dir($sessionRoot)
        || ($sessionAction === 'start' ? ($sessionHost !== null && !in_array($sessionHost, ['shell', 'agy', 'codex', 'claude'], true)) : $sessionHost !== null)
        || ($sessionPort !== null && (!in_array($sessionAction, ['serve', 'start', 'attach'], true)
            || preg_match('/^[0-9]{1,5}$/D', $sessionPort) !== 1 || (int) $sessionPort < 1024 || (int) $sessionPort > 65535))
        || ($sessionFormat !== null && ($sessionAction !== 'status' || !in_array($sessionFormat, ['text', 'json'], true)))) {
        fwrite(STDERR, "Error: invalid session root, host, port or format.\n");
        exit(1);
    }

    $script = dirname(__DIR__) . '/tools/terminal/local-cockpit.cjs';
    if (!is_file($script)) {
        fwrite(STDERR, "Error: the optional terminal cockpit is not installed.\n");
        exit(1);
    }
    if (!function_exists('proc_open')) {
        fwrite(STDERR, "Error: PHP process execution is unavailable for the optional terminal cockpit.\n");
        exit(1);
    }
    $sessionArgs = ['node', $script, '--root=' . $sessionRoot, '--task=' . $taskId];
    $sessionArgs[] = $sessionAction === 'start' ? '--start=' . ($sessionHost ?? 'shell') : '--' . $sessionAction;
    if ($sessionPort !== null) {
        $sessionArgs[] = '--port=' . $sessionPort;
    }
    if ($sessionFormat !== null) {
        $sessionArgs[] = '--format=' . $sessionFormat;
    }
    putenv('AGENT_UI_COMPOSER_AUTOLOAD=' . $autoload);
    putenv('AGENT_UI_SESSION_PARENT_PID=' . (string) getmypid());
    $sessionProcess = proc_open($sessionArgs, [0 => STDIN, 1 => STDOUT, 2 => STDERR], $sessionPipes);
    if (!is_resource($sessionProcess)) {
        fwrite(STDERR, "Error: unable to start the optional Node.js terminal cockpit.\n");
        exit(1);
    }
    $sessionExitCode = proc_close($sessionProcess);
    if ($sessionExitCode === 127) {
        fwrite(STDERR, "Error: Node.js is required for the optional terminal cockpit.\n");
    }
    exit($sessionExitCode);
}
if (!in_array($command, ['serve', 'status'], true)) {
    fwrite(STDERR, sprintf("Unknown command: %s\n", $command));
    $help();
    exit(1);
}

$host = '127.0.0.1';
$port = 8088;
$projectRoot = getcwd();
$format = 'text';

foreach ($args as $arg) {
    if ($arg === '--help' || $arg === '-h') {
        $help();
        exit(0);
    }
    if (str_starts_with($arg, '--port=')) {
        $port = (int) substr($arg, 7);
        continue;
    }
    if (str_starts_with($arg, '--host=')) {
        $host = substr($arg, 7);
        continue;
    }
    if (str_starts_with($arg, '--root=')) {
        $projectRoot = substr($arg, 7);
        continue;
    }
    if (str_starts_with($arg, '--format=')) {
        $format = substr($arg, 9);
        continue;
    }

    fwrite(STDERR, sprintf("Unknown option: %s\n", $arg));
    exit(1);
}

if (!is_string($projectRoot) || !is_dir($projectRoot)) {
    fwrite(STDERR, "Error: Project root directory does not exist: {$projectRoot}\n");
    exit(1);
}

$realProjectRoot = realpath($projectRoot);
if ($realProjectRoot === false) {
    fwrite(STDERR, "Error: Unable to resolve realpath for project root: {$projectRoot}\n");
    exit(1);
}
if ($host === '' || preg_match('/^[A-Za-z0-9.:-]+$/D', $host) !== 1) {
    fwrite(STDERR, "Error: Host must be a plain local hostname or IP address.\n");
    exit(1);
}
if ($port < 1 || $port > 65535) {
    fwrite(STDERR, "Error: Port must be between 1 and 65535.\n");
    exit(1);
}
if (!in_array($format, ['text', 'json'], true)) {
    fwrite(STDERR, "Error: --format must be text or json.\n");
    exit(1);
}
if ($command === 'serve' && $format !== 'text') {
    fwrite(STDERR, "Error: --format is supported only by status.\n");
    exit(1);
}

if ($command === 'status') {
    $identity = ControlPlaneIdentity::fromProjectRoot($realProjectRoot);
    $result = (new ControlPlaneProbe())->probe($host, $port, $identity);

    if ($format === 'json') {
        echo json_encode($result, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";
    } else {
        echo sprintf("agent-ui: %s\n", $result['status']);
        echo sprintf("URL: %s\n", $result['url']);
        echo sprintf("Project: %s\n", $result['project_id']);
        if ($result['detail'] !== null) {
            echo sprintf("Detail: %s\n", $result['detail']);
        }
    }

    exit($result['status'] === 'ready' ? 0 : 2);
}

$publicDir = dirname(__DIR__) . '/public';
$routerScript = $publicDir . '/index.php';

if (!file_exists($routerScript)) {
    fwrite(STDERR, "Error: Router script not found: {$routerScript}\n");
    exit(1);
}

echo "Starting agent-ui local control plane...\n";
echo "  Project root: {$realProjectRoot}\n";
echo "  URL:          http://{$host}:{$port}\n";
echo "Press Ctrl-C to stop.\n\n";

putenv('AGENT_UI_PROJECT_ROOT=' . $realProjectRoot);
$_ENV['AGENT_UI_PROJECT_ROOT'] = $realProjectRoot;
putenv('AGENT_UI_COMPOSER_AUTOLOAD=' . $autoload);
$_ENV['AGENT_UI_COMPOSER_AUTOLOAD'] = $autoload;

$phpBinary = PHP_BINARY;
$serveCommand = sprintf(
    '%s -S %s:%d -t %s %s',
    escapeshellarg($phpBinary),
    escapeshellarg($host),
    $port,
    escapeshellarg($publicDir),
    escapeshellarg($routerScript)
);

passthru($serveCommand, $exitCode);
exit($exitCode);
