{
  "name": "voku/agent-ui",
  "description": "Local server-rendered human control plane for the governed voku/agent-loop workflow.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/voku/agent-ui",
  "support": {
    "issues": "https://github.com/voku/agent-ui/issues",
    "source": "https://github.com/voku/agent-ui"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "agent-loop",
    "ui",
    "control-plane",
    "web-interface",
    "governance",
    "human-in-the-loop",
    "ai",
    "llm"
  ],
  "authors": [
    {
      "name": "Lars Moelleken",
      "homepage": "https://github.com/voku"
    }
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/voku"
    }
  ],
  "require": {
    "php": "^8.3",
    "voku/agent-kanban": "^0.4.0",
    "voku/agent-learning": "^0.16.1",
    "voku/agent-loop": "^0.20.0",
    "voku/agent-map": "^0.10.0",
    "voku/agent-recall-compiler": "^0.15.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "voku/agent-loop-runner": "^0.1.0"
  },
  "autoload": {
    "psr-4": {
      "voku\\AgentUi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "voku\\AgentUi\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/agent-ui"
  ],
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=512M",
    "template-lint": "find templates -name '*.php' -print0 | xargs -0 -n1 php -l",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix",
    "ci": [
      "@composer validate --strict",
      "@test",
      "@phpstan",
      "@template-lint",
      "@cs-check"
    ]
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  },
  "suggest": {
    "voku/agent-loop-runner": "Install to enable the optional managed execution surface."
  }
}
